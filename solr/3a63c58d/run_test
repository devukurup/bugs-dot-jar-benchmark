#!/bin/bash
script_dir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
benchmark_name=$(echo $script_dir | rev | cut -d "/" -f 3 | rev)
project_name=$(echo $script_dir | rev | cut -d "/" -f 2 | rev)
bug_id=$(echo $script_dir | rev | cut -d "/" -f 1 | rev)
dir_name=/experiment/$benchmark_name/$project_name/$bug_id
TEST_CLASS=$1
TIMEOUT=${2:-300}
EXIT_CODE=1
cd $dir_name/src/src

if [ -z "$TEST_CLASS" ]; then
    echo "requires a test class"
    exit 255
fi

SUB_PROJECT="lucene/queries"

[ -f /etc/environment ] && source /etc/environment

if [ -z "$JAVA_HOME" ]; then
    for java_dir in /usr/lib/jvm/java-*-openjdk-amd64; do
        if [ -d "$java_dir" ]; then
            export JAVA_HOME="$java_dir"
        fi
    done
fi

TEST_NAME=$(echo "$TEST_CLASS" | rev | cut -d '.' -f 1 | rev)

if [ "$SUB_PROJECT" != "<SUB_PROJECT>" ] && [ -n "$SUB_PROJECT" ]; then
    cd "$SUB_PROJECT"
fi
timeout $TIMEOUT ant test -Dtestcase=$TEST_NAME > /dev/null 2>&1

EXIT_CODE=$?

if [[ $EXIT_CODE -eq 0 ]]; then
    echo "PASS"
else
    echo "FAIL"
fi

exit $EXIT_CODE
